      },
      "id": "83ed969c-d337-4814-bf7c-2de97de8bb21",
      "name": "Odosli potvrdenie",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [1340, 0],
      "credentials": { "telegramApi": { "id": "Yi7MKfhcKkOKHZbl", "name": "pikart" } }
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "resource": "file",
        "operation": "edit",
        "owner": "praecantat0r",
        "repository": "PIKART",
        "filePath": "index.html",
        "fileContent": "={{ $json.updatedContent }}",
        "commitMessage": "={{ $json.commitMessage }}",
        "additionalParameters": { "branch": {} }
      },
      "id": "82d2b0e6-6eaf-4bc1-8203-bea1e7125065",
      "name": "Aktualizuj index.html",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [1120, 0],
      "credentials": { "githubOAuth2Api": { "id": "EYjxyOOPAKMU0gw5", "name": "GitHub OAuth2 API" } }
    },
    {
      "parameters": {
        "jsCode": "const parsed = $('Spracuj spravu').first().json;\nconst file = $('Stiahni index.html').first().json;\n\nconst raw = file.content ?? null;\nif (!raw) {\n  return [{ json: { error: true, chatId: parsed.chatId, reply: '❌ Súbor sa nepodarilo stiahnuť.' } }];\n}\n\nconst current = Buffer.from(raw.replace(/\\n/g, ''), 'base64').toString('utf8');\n\nconst newBlock = `var NEW_COURSE = {\n  enabled: true,\n  type: \"${parsed.type}\",\n  title: \"${parsed.title}\",\n  date: \"${parsed.date}\",\n  description: \"${parsed.description}\"\n};`;\n\nconst updated = current.replace(/var NEW_COURSE = \\{[\\s\\S]*?\\};/, newBlock);\n\nif (updated === current) {\n  return [{ json: { error: true, chatId: parsed.chatId, reply: '❌ NEW_COURSE blok sa nenašiel v súbore.' } }];\n}\n\nreturn [{ json: {\n  error: false,\n  chatId: parsed.chatId,\n  sha: file.sha,\n  updatedContent: updated,\n  commitMessage: `Popup: ${parsed.type} – ${parsed.date}`,\n  reply: `✅ Popup aktualizovaný!\\n\\n*${parsed.type}*\\n${parsed.date}\\n${parsed.description}\\n\\nVercel redeployuje za ~30 sek.`\n}}];"
      },
      "id": "2d8bf8a0-f052-4054-b9d4-d6b003ebc6e0",
      "name": "Priprav novy obsah",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [672, 0]
    },
    {
      "parameters": {
        "url": "https://api.github.com/repos/praecantat0r/PIKART/contents/index.html",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Accept", "value": "application/vnd.github.v3+json" }]
        },
        "options": {}
      },
      "id": "d4798f00-a9d2-4b5a-bbe8-9ae35816e14b",
      "name": "Stiahni index.html",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [448, 0],
      "credentials": {
        "githubOAuth2Api": { "id": "EYjxyOOPAKMU0gw5", "name": "GitHub OAuth2 API" },
        "httpHeaderAuth": { "id": "1Vo3aFoVdlNZMAwC", "name": "Header Auth account" }
      }
    },
    {
      "parameters": {
        "jsCode": "const message = ($input.first().json?.message?.text || '').trim();\nconst chatId  = $input.first().json?.message?.chat?.id;\nconst lines   = message.split('\\n').map(l => l.trim()).filter(l => l);\n\nif (lines.length < 2) {\n  return [{ json: { error: true, chatId, reply: '❌ Nesprávny formát. Pošli:\\nTyp akcie\\n15. jún 2026\\nKrátky popis' } }];\n}\n\nreturn [{ json: {\n  error: false,\n  chatId,\n  type: lines[0],\n  date: lines[1],\n  description: lines[2] || '',\n  title: lines[0]\n}}];"
      },
      "id": "c4b83153-687d-47cb-99af-f4a19670238f",
      "name": "Spracuj spravu",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [224, 0]
    },
    {
      "id": "if-bez-chyby",
      "name": "Bez chyby",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [896, 0],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 1 },
          "conditions": [{ "id": "c1", "leftValue": "={{ $json.error }}", "rightValue": true, "operator": { "type": "boolean", "operation": "notEqual" } }],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "parameters": {
        "updates": ["message"],
        "additionalFields": {}
      },
      "id": "f5d4919e-9f5f-412d-9adf-5382aeefdd60",
      "name": "Telegram Trigger",
