    {
      "parameters": {
        "jsCode": "const parsed   = $('Parse').item.json;\nconst imgBase64 = $('To Base64').item.json.img_base64;\nconst imgSha   = $('SHA Image').item.json.sha   || null;\nconst popupSha = $('SHA Popup JSON').item.json.sha || null;\n\nif (!imgBase64) throw new Error('img_base64 je prazdne.');\n\nconst imgBody = { message: 'popup: image', content: imgBase64 };\nif (imgSha) imgBody.sha = imgSha;\n\nconst popupB64 = Buffer.from(parsed.popup_json).toString('base64');\nconst popupBody = { message: 'popup: ' + JSON.parse(parsed.popup_json).title, content: popupB64 };\nif (popupSha) popupBody.sha = popupSha;\n\nreturn [{ json: {\n  chat_id:    parsed.chat_id,\n  img_body:   imgBody,\n  popup_body: popupBody\n} }];"
      },
