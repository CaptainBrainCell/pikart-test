    },
    {
      "parameters": {
        "jsCode": "const token    = $('Config').item.json.TELEGRAM_BOT_TOKEN;\nconst filePath = $('getFile').item.json.result.file_path;\nconst url      = `https://api.telegram.org/file/bot${token}/${filePath}`;\n\nconst arrayBuffer = await this.helpers.httpRequest({\n  method: 'GET',\n  url,\n  responseType: 'arraybuffer'\n});\n\nconst base64 = Buffer.from(new Uint8Array(arrayBuffer)).toString('base64');\nreturn [{ json: { img_base64: base64 } }];"
      },
