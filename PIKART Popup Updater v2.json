      "parameters": {
        "jsCode": "return [{ json: {\n  TELEGRAM_BOT_TOKEN: 'ТВОЙ_TELEGRAM_TOKEN',\n  GITHUB_TOKEN:       'ТВОЙ_GITHUB_TOKEN',\n  GITHUB_OWNER:       'CaptainBrainCell',\n  GITHUB_REPO:        'pikart-test'\n} }];"
      },
      "id": "11111111-0000-0000-0000-000000000002",
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "jsCode": "const msg = $('Telegram Trigger').item.json.message;\nif (!msg) return [{ json: { ok: 'no', chat_id: 0, error: 'Ziadna sprava.' } }];\n\nconst chatId = msg.chat.id;\nconst caption = msg.caption || '';\n\nif (!msg.photo || msg.photo.length === 0) {\n  return [{ json: {\n    ok: 'no',\n    chat_id: chatId,\n    error: 'Posli FOTKU s titulkom (caption). Priklad:\\n\\nNazov: Quiz Night\\nDatum: Utorok 20. maja\\nCas: 19:00\\nPopis: Pride si zasutazit...\\nCTA text: Rezervovat stol\\nCTA url: tel:+421917261425\\n\\nCTA text a CTA url su nepovinne.'\n  } }];\n}\n\nconst fileId = msg.photo[msg.photo.length - 1].file_id;\n\nfunction get(key) {\n  const m = caption.match(new RegExp('^' + key + '\\\\s*:\\\\s*(.+)$', 'im'));\n  return m ? m[1].trim() : '';\n}\n\nconst title = get('N.zov') || get('Nazov');\nconst date  = get('D.tum') || get('Datum');\nconst time  = get('.as')   || get('Cas');\nconst desc  = get('Popis');\nconst ctaT  = get('CTA text');\nconst ctaU  = get('CTA url');\n\nif (!title || !date || !time || !desc) {\n  const missing = [!title && 'Nazov', !date && 'Datum', !time && 'Cas', !desc && 'Popis'].filter(Boolean).join(', ');\n  return [{ json: {\n    ok: 'no',\n    chat_id: chatId,\n    error: 'Chybaju polia: ' + missing + '.\\nPosli fotku znova s uplnym titulkom.'\n  } }];\n}\n\nconst popup = {\n  active: true,\n  image: 'Assets/Photos/popup-event.jpg',\n  imageAlt: title,\n  title,\n  date,\n  time,\n  description: desc\n};\nif (ctaT) popup.cta = { text: ctaT, url: ctaU || 'tel:+421917261425' };\n\nreturn [{ json: {\n  ok: 'yes',\n  chat_id: chatId,\n  file_id: fileId,\n  popup_json: JSON.stringify(popup, null, 2)\n} }];"
      },
